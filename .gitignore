# BEGIN AI-DLC:gitignore
# AI-DLC: local working files
aidlc/active-space
aidlc/spaces/*/intents/active-intent
aidlc/.aidlc-clone-id
aidlc.settings.local.json
aidlc/.aidlc-unit-scope.json
aidlc/.aidlc-unit-parked
aidlc/.aidlc-claim-generations.json
aidlc/.aidlc-unit-participant
aidlc/.aidlc-claim-registry.json
aidlc/.aidlc-unit-releases/
aidlc/.aidlc-unit-merges/
aidlc/.aidlc-active-space-*.tmp
aidlc/active-memory/
aidlc/.aidlc-sessions/
aidlc/.aidlc-request-text/
aidlc/spaces/*/intents/.aidlc-*
**/aidlc/spaces/*/intents/**/.aidlc-engine/
**/aidlc/spaces/*/intents/**/.aidlc-sensors/
aidlc/spaces/*/knowledge/documentkb/.journal/
aidlc/spaces/*/knowledge/.sources.local.json
aidlc/spaces/*/intents/*/runtime-graph.json
aidlc/spaces/*/intents/*/.aidlc-*
aidlc/diagnostics/
.claude/settings.local.json
# END AI-DLC:gitignore

# Dự án employee-crud: file sinh ra khi build/chạy, không đưa lên Git
bin/
obj/
*.user
.vs/
.env
# File bí mật hay gặp (chứng chỉ, khóa, file cấu hình riêng): lỡ commit là phải đổi mật khẩu và viết lại lịch sử Git
.env.*
!frontend/.env.development
*.pfx
*.p12
*.pem
*.key
secrets.json
node_modules/
dist/
TestResults/
coverage*/
# Log của công cụ kiểm trình duyệt (Playwright) khi kiểm tay
.playwright-mcp/
# File log bất kỳ, thư mục cấu hình của IDE JetBrains (Rider), và file biến bí mật của file .http
# (Visual Studio và Rider đọc http-client.private.env.json để điền mật khẩu, token khi gọi thử API)
*.log
.idea/
http-client.private.env.json
